{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budzet-domowy",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "d1_databases": [ { "binding": "DB", "database_name": "budzet", "database_id": "UZUPELNIJ-PO-UTWORZENIU-BAZY", "migrations_dir": "migrations" } ],
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "OWNER_EMAIL": "" },
  "observability": { "enabled": false }
}
