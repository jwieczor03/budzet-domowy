{
  "name": "budzet-domowy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/preview.mjs",
    "build": "tsc -b && vite build --configLoader native",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src server scripts tests *.json *.md",
    "format:check": "prettier --check src server scripts tests *.json *.md",
    "deploy": "pnpm build && wrangler deploy",
    "db:remote": "wrangler d1 migrations apply budzet --remote"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.3.0",
    "typescript": "^5.9.0",
    "prettier": "^3.7.0",
    "wrangler": "^4.0.0"
  }
}
